{
  "name": "comment-streak-sync",
  "private": true,
  "type": "module",
  "description": "Optional sync server for Comment Streak for LinkedIn: email-code sign-in and per-device daily counts.",
  "scripts": {
    "dev": "node dev.js",
    "dev:neon": "node --env-file=.env.local dev.js",
    "test": "node --test test/*.test.mjs",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "smoke": "node --env-file=.env.local scripts/smoke.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  }
}
